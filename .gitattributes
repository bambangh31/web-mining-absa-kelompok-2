* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary

# Data mentah disimpan byte demi byte; teks ulasan memuat baris baru LF di dalam sel.
data/raw/*.csv -text
# Split berversi harus cocok dengan hash input anotasi pada semua platform.
data/annotations/split.csv -text -whitespace
